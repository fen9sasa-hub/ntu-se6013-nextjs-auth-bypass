# Do not use these placeholders. Run: node deploy/init-env.mjs
LAB_PORT=4317
LAB_PUBLIC_ORIGIN=http://127.0.0.1:4317
CONTROL_USER=operator
CONTROL_PASSWORD=GENERATE_A_RANDOM_OPERATOR_PASSWORD
LAB_USER=analyst
LAB_PASSWORD=GENERATE_A_DIFFERENT_RANDOM_TARGET_PASSWORD
LAB_SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
COOKIE_SECURE=false
# M4 targets (../m4-remediation/compose.defences.yaml). Run: node ../m4-remediation/init-env.mjs
# These placeholders are deliberately shorter than the targets accept, so a copied example fails instead of running with public values.
PATCHED_PASSWORD=GENERATE_ME
PATCHED_SESSION_SECRET=GENERATE_ME
HEADER_FILTER_PASSWORD=GENERATE_ME
HEADER_FILTER_SESSION_SECRET=GENERATE_ME
SERVER_AUTH_PASSWORD=GENERATE_ME
SERVER_AUTH_SESSION_SECRET=GENERATE_ME
